<launch>
    <!-- LVIO benchmark: r3live on the BUNKER common bag (see ../../NOTES.md).
         Livox Mid-360 + Livox IMU + D455F colour rectified at 15 Hz. Needs lvio/patch_r3live.py (Dockerfile). -->
    <arg name="rviz" default="false"/>
    <arg name="input_bag" default=""/>   <!-- unused: the bag is played from outside -->
    <arg name="out_dir" default="/lvio/out"/>

    <param name="use_sim_time" value="true"/>

    <!-- The Livox front end subscribes /livox/lidar (hard-coded, livox_ros_driver/CustomMsg) and publishes
         /laser_cloud_flat. r3live subscribes Image_topic and Image_topic/compressed. -->
    <param name="/LiDAR_pointcloud_topic" type="string" value="/laser_cloud_flat"/>
    <param name="/IMU_topic" type="string" value="/livox/imu"/>
    <param name="/Image_topic" type="string" value="/lvio/d455_rect"/>

    <rosparam command="load" file="$(arg out_dir)/config/bunker/r3live.yaml"/>
    <param name="r3live_common/map_output_dir" type="string" value="$(arg out_dir)/r3live_output"/>

    <node pkg="r3live" type="r3live_LiDAR_front_end" name="r3live_LiDAR_front_end" output="screen" required="true">
        <remap from="/livox/lidar" to="/lvio/livox/lidar"/>
    </node>
    <node pkg="r3live" type="r3live_mapping" name="r3live_mapping" output="screen" required="true">
        <!-- LiDAR origin in the Livox IMU frame (bunker_calibration.yaml imu.T_lidar_imu, inverted) -->
        <env name="LVIO_LIDAR_OFFSET_TO_IMU" value="-0.011 -0.02329 0.04412"/>
    </node>

    <group if="$(arg rviz)">
        <node name="rvizvisualisation" pkg="rviz" type="rviz" output="log"
              args="-d $(find r3live)/../config/rviz/r3live_rviz_config.rviz"/>
    </group>
</launch>
