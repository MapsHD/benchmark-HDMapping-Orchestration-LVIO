<launch>
    <!-- LVIO benchmark: FAST-LIVO2 on the COCO common bag (see ../NOTES.md).
         Ouster cloud + Alphasense IMU + cam0 fisheye at 10 Hz as raw image. -->
    <arg name="rviz" default="false"/>
    <arg name="input_bag" default=""/>   <!-- unused: the bag is played from outside -->
    <arg name="out_dir" default="/lvio/out"/>

    <param name="use_sim_time" value="true"/>

    <!-- 30 Hz -> 10 Hz: keep 1 of every 3 frames (count based, deterministic) -->
    <node pkg="topic_tools" type="drop" name="lvio_cam0_10hz"
          args="/alphasense_driver_ros/cam0/compressed 2 3 /lvio/cam0_10hz/compressed"/>
    <!-- FAST-LIVO2 subscribes sensor_msgs/Image only -->
    <node pkg="image_transport" type="republish" name="lvio_cam0_10hz_raw"
          args="compressed in:=/lvio/cam0_10hz raw out:=/lvio/cam0_10hz/image_raw"/>

    <rosparam command="load" file="$(arg out_dir)/config/coco.yaml"/>
    <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen" required="true">
        <rosparam file="$(arg out_dir)/config/camera_coco.yaml"/>
    </node>

    <group if="$(arg rviz)">
        <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz"/>
    </group>
</launch>
