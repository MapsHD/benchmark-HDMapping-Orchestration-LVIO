<launch>
    <!-- LVIO benchmark: FAST-LIVO2 on the BUNKER common bag (see ../../NOTES.md).
         Livox Mid-360 (livox_ros_driver copy) + Livox IMU + D455F colour rectified at 10 Hz as raw image. -->
    <arg name="rviz" default="false"/>
    <arg name="input_bag" default=""/>   <!-- unused: the bag is played from outside -->
    <arg name="out_dir" default="/lvio/out"/>

    <param name="use_sim_time" value="true"/>

    <!-- 15 Hz -> 10 Hz: drop 1 of every 3 frames (count based, deterministic) -->
    <node pkg="topic_tools" type="drop" name="lvio_d455_10hz"
          args="/lvio/d455_rect/compressed 1 3 /lvio/d455_10hz/compressed"/>
    <!-- FAST-LIVO2 subscribes sensor_msgs/Image only -->
    <node pkg="image_transport" type="republish" name="lvio_d455_10hz_raw"
          args="compressed in:=/lvio/d455_10hz raw out:=/lvio/d455_10hz/image_raw"/>

    <rosparam command="load" file="$(arg out_dir)/config/bunker/fast_livo2.yaml"/>
    <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen" required="true">
        <rosparam file="$(arg out_dir)/config/bunker/camera.yaml"/>
    </node>

    <group if="$(arg rviz)">
        <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz"/>
    </group>
</launch>
